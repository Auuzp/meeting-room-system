@echo off
chcp 65001 > nul
title เชื่อมต่อ Firebase Firestore อัตโนมัติ
color 0A

echo ===============================================================================
echo                เชื่อมต่อ Firebase Firestore สำหรับระบบจองห้องประชุม
echo ===============================================================================
echo.
echo กำลังตรวจหาไฟล์กุญแจ Firebase (.json) ในเครื่องและโฟลเดอร์ Downloads...
echo.

node scripts/connect-firebase.js

if %errorlevel% equ 0 (
    echo.
    echo ===============================================================================
    echo [OK] ระบบเชื่อมต่อกับ Firebase Firestore เรียบร้อยแล้ว!
    echo ===============================================================================
) else (
    echo.
    echo ===============================================================================
    echo [!] ยังไม่พบไฟล์ .json จาก Firebase Console
    echo กรุณาดาวน์โหลด Private Key จาก Firebase Console แล้วกดรันไฟล์นี้ใหม่อีกครั้ง
    echo ===============================================================================
)

pause
